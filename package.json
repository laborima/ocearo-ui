{
  "name": "ocearo-ui",
  "version": "2.1.3",
  "private": false,
  "description": "Open-source 3D sailing display for Signal K: the boat, the sea and the AIS traffic in real time, sail trim, rules of the road, man overboard, anchor watch, 3D bathymetry, tides and weather",
  "license": "Apache-2.0",
  "author": "Matthieu Laborie",
  "homepage": "https://ocearo.leslaborie.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laborima/ocearo-ui.git"
  },
  "keywords": [
    "signalk-webapp",
    "signalk-category-chart-plotters",
    "signalk-category-instruments",
    "signalk-category-ais",
    "signalk-category-weather",
    "boating",
    "sailing",
    "marine",
    "navigation",
    "3d",
    "ais",
    "colregs",
    "bathymetry",
    "tides",
    "weather",
    "raspberry-pi"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "link": "ln -s $PWD/out $HOME/.signalk/node_modules/ocearo-ui"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@signalk/client": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@use-gesture/react": "^10.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "framer-motion": "^14.0.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "next": "^16.3.8",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.1",
    "three": "^0.186.1"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "glob": "^11.0.0",
    "rimraf": "^6.0.0",
    "flat-cache": "^6.0.0",
    "file-entry-cache": "^9.0.0"
  },
  "signalk": {
    "appIcon": "./icons/ocearo.webp",
    "displayName": "Ocean Robot UI",
    "screenshots": [
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/hero.jpg",
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/bathymetry.jpg",
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/traffic.jpg",
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/weather.jpg",
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/chart.jpg",
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/dashboard.jpg"
    ]
  }
